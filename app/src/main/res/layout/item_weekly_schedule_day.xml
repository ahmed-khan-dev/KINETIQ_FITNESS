<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_outline"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Day Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvScheduleDayBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/kinetic_card_highest"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="MON"
            android:textColor="@color/kinetic_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScheduleSessionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Upper Body A"
            android:textColor="@color/kinetic_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScheduleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 sets"
            android:textColor="@color/kinetic_secondary"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Exercises preview list -->
    <TextView
        android:id="@+id/tvScheduleExercisesPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/kinetic_text_muted"
        android:textSize="12sp" />

</LinearLayout>
