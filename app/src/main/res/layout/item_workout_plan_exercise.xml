<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_outline"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Exercise Number Indicator -->
    <TextView
        android:id="@+id/tvExerciseNumber"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@color/kinetic_card_highest"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/kinetic_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Exercise Name and Meta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemExerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Dumbbell Bench Press"
            android:textColor="@color/kinetic_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemExerciseMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chest • 3 sets × 10 reps • 90s rest"
            android:textColor="@color/kinetic_text_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvItemExerciseStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@color/kinetic_card_high"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="Ready"
        android:textColor="@color/kinetic_primary"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
