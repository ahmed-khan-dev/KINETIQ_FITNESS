<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_completed_set_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Green Checkmark Circle -->
    <TextView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_stadium_pill"
        android:backgroundTint="@color/kinetic_primary"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Set Number & Target -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCompletedSetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set 1"
            android:textColor="@color/kinetic_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompletedSetSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Target: 10 reps"
            android:textColor="@color/kinetic_text_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Logged Result & RPE -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCompletedSetResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 reps × 24.0 kg"
            android:textColor="@color/kinetic_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompletedSetRpe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="RPE 8.0"
            android:textColor="@color/kinetic_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
