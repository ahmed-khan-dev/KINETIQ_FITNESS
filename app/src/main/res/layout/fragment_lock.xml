<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kinetic_surface"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <ProgressBar
            android:id="@+id/pbCheckingSession"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/kinetic_primary"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/authContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- BRAND LOGO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:cardBackgroundColor="@color/kinetic_card_surface"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kinetic_primary"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivLockLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:contentDescription="Kinetiq Logo"
                    android:src="@drawable/ic_kinetiq_logo" />

            </com.google.android.material.card.MaterialCardView>

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvLockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="-0.02"
                android:text="Kinetiq App Lock"
                android:textColor="@color/kinetic_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLockSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Authenticate to unlock your AI Fitness &amp; Diet Coach"
                android:textColor="@color/kinetic_text_muted"
                android:textSize="14sp" />

            <!-- BIOMETRIC CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/kinetic_card_surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kinetic_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_stadium_pill"
                        android:backgroundTint="@color/kinetic_card_high"
                        android:gravity="center"
                        android:text="👆"
                        android:textSize="26sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBiometricUnlock"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/kinetic_card_high"
                        android:letterSpacing="0.04"
                        android:text="Unlock with Biometrics"
                        android:textColor="@color/kinetic_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Touch sensor or tap above to use Biometrics"
                        android:textColor="@color/kinetic_text_muted"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DIVIDER -->
            <TextView
                android:id="@+id/tvOrPinLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_stadium_pill"
                android:backgroundTint="@color/kinetic_card_high"
                android:letterSpacing="0.12"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="— OR USE PIN —"
                android:textColor="@color/kinetic_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- PIN DOTS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pinDot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_dot"
                    android:backgroundTint="@color/kinetic_card_highest" />

                <View
                    android:id="@+id/pinDot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_dot"
                    android:backgroundTint="@color/kinetic_card_highest" />

                <View
                    android:id="@+id/pinDot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_dot"
                    android:backgroundTint="@color/kinetic_card_highest" />

                <View
                    android:id="@+id/pinDot4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_dot"
                    android:backgroundTint="@color/kinetic_card_highest" />

            </LinearLayout>

            <!-- Backward-compat input (kept for your logic; hidden because the keypad replaces it) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter 4-Digit PIN"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:inputType="numberPassword"
                    android:maxLength="4" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- KEYPAD -->
            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="3"
                android:rowCount="4">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey1"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="1"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey2"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="2"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey3"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="3"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey4"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="4"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey5"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="5"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey6"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="6"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey7"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="7"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey8"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="8"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey9"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="9"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKey0"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_column="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="0"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKeyBackspace"
                    android:layout_width="84dp"
                    android:layout_height="60dp"
                    android:layout_column="2"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="⌫"
                    android:textColor="@color/kinetic_tertiary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/kinetic_primary"
                android:letterSpacing="0.1"
                android:text="Submit PIN"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- SECURITY BADGE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_stadium_pill"
                android:backgroundTint="@color/kinetic_card_surface"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🔒 15-Minute Session Lock · Encrypted Vault"
                android:textColor="@color/kinetic_text_muted"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>