<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kinetic_surface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- ============ TOP SESSION BAR ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/kinetic_surface_container_low"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/kinetic_card_high"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Pulsing dot -->
                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_pulsing_dot" />

                    <!-- Session Name -->
                    <TextView
                        android:id="@+id/tvSessionName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="-0.01"
                        android:text="Upper Body A"
                        android:textColor="@color/kinetic_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Live Timer -->
                    <TextView
                        android:id="@+id/tvLiveWorkoutTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_stadium_pill"
                        android:backgroundTint="@color/kinetic_card_highest"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="00:00"
                        android:textColor="@color/kinetic_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- End Session -->
                    <TextView
                        android:id="@+id/btnEndSession"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stadium_pill"
                        android:backgroundTint="@color/kinetic_card_highest"
                        android:clickable="true"
                        android:focusable="true"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✕ END"
                        android:textColor="@color/kinetic_error"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Progress -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvWorkoutSessionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.04"
                            android:text="Exercise 1 of 5"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSessionPercentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0% Complete"
                            android:textColor="@color/kinetic_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbSessionProgress"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:progress="0"
                        android:progressBackgroundTint="@color/kinetic_card_high"
                        android:progressTint="@color/kinetic_primary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============ CURRENT EXERCISE HERO ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/kinetic_card_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/kinetic_card_high"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tri-colour accent strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/kinetic_primary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/kinetic_secondary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/kinetic_tertiary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Muscle chip -->
                    <TextView
                        android:id="@+id/tvExerciseMuscles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stadium_pill"
                        android:backgroundTint="@color/kinetic_card_high"
                        android:letterSpacing="0.12"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="CHEST • TRICEPS"
                        android:textColor="@color/kinetic_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Exercise Name -->
                    <TextView
                        android:id="@+id/tvExerciseName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:letterSpacing="-0.02"
                        android:text="Dumbbell Bench Press"
                        android:textColor="@color/kinetic_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- Sets / Rest -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvExerciseSets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 sets × 10 reps"
                            android:textColor="@color/kinetic_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:text="•"
                            android:textColor="@color/kinetic_text_muted" />

                        <TextView
                            android:id="@+id/tvRestSeconds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rest: 90 sec"
                            android:textColor="@color/kinetic_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Coach cue -->
                    <LinearLayout
                        android:id="@+id/cardCoachCue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.15"
                            android:text="💡 COACH FORM CUE"
                            android:textColor="@color/kinetic_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvExerciseNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="4dp"
                            android:text="Maintain neutral spine, drive feet firmly into the floor, and control the eccentric descent."
                            android:textColor="@color/kinetic_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============ REST TIMER ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRestTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/kinetic_surface_container_low"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/kinetic_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_stadium_pill"
                    android:backgroundTint="@color/kinetic_card_highest"
                    android:gravity="center"
                    android:text="⏳"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRestCountdownText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.02"
                            android:text="01:30"
                            android:textColor="@color/kinetic_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.15"
                            android:text="REST"
                            android:textColor="@color/kinetic_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hydrate and catch breath for next set"
                        android:textColor="@color/kinetic_text_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRest30s"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="12dp"
                    android:text="+30s"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkipRest"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingHorizontal="12dp"
                    android:text="Skip"
                    android:textColor="@color/kinetic_secondary"
                    android:textSize="11sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/kinetic_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============ SET-BY-SET SECTION ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/kinetic_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.15"
                    android:text="TARGET SETS"
                    android:textColor="@color/kinetic_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="REPS / LOAD"
                    android:textColor="@color/kinetic_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Completed sets -->
            <LinearLayout
                android:id="@+id/llCompletedSetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- ACTIVE SET CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveSet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/kinetic_card_surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kinetic_primary"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveSetTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="-0.01"
                            android:text="Active Set 1"
                            android:textColor="@color/kinetic_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveSetBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_primary"
                            android:letterSpacing="0.12"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="ACTIVE"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveSetPrescribed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Prescribed: 10 reps"
                        android:textColor="@color/kinetic_text_muted"
                        android:textSize="12sp" />

                    <!-- STEPPERS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Reps -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_day_tab_normal"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.1"
                                android:text="REPS FINISHED"
                                android:textColor="@color/kinetic_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRepDec"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="−"
                                    android:textColor="@color/kinetic_text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="14dp" />

                                <TextView
                                    android:id="@+id/tvRepVal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="10"
                                    android:textColor="@color/kinetic_primary"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRepInc"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="+"
                                    android:textColor="@color/kinetic_text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="14dp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Load -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_day_tab_normal"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.1"
                                android:text="LOAD (KG)"
                                android:textColor="@color/kinetic_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnWeightDec"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="−"
                                    android:textColor="@color/kinetic_text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="14dp" />

                                <TextView
                                    android:id="@+id/tvWeightVal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="0.0"
                                    android:textColor="@color/kinetic_text_primary"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnWeightInc"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="+"
                                    android:textColor="@color/kinetic_text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="14dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- RPE ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.1"
                            android:text="EFFORT LEVEL (RPE)"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRpe7"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="4dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="7"
                            android:textColor="@color/kinetic_text_primary"
                            android:textSize="13sp"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRpe8"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/kinetic_primary"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="8"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRpe9"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="4dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="9"
                            android:textColor="@color/kinetic_text_primary"
                            android:textSize="13sp"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRpe10"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="10"
                            android:textColor="@color/kinetic_text_primary"
                            android:textSize="13sp"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                    <!-- PRESERVED EDIT TEXT FIELDS (SYNCHRONIZED WITH STEPPERS) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/etWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="Weight (kg)"
                            android:inputType="numberDecimal" />

                        <EditText
                            android:id="@+id/etCompletedReps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="Completed reps"
                            android:inputType="number" />

                        <EditText
                            android:id="@+id/etCompletedSets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="Completed sets"
                            android:inputType="number" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Pending sets -->
            <LinearLayout
                android:id="@+id/llPendingSetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- COMPLETION SUMMARY -->
        <TextView
            android:id="@+id/tvCompletionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_outline"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/kinetic_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- ============ BOTTOM ACTIONS ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompleteExercise"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:backgroundTint="@color/kinetic_primary"
                android:letterSpacing="0.1"
                android:text="✓  COMPLETE SET 1"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="22dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkipExercise"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.05"
                    android:text="Skip Exercise"
                    android:textColor="@color/kinetic_text_muted"
                    android:textSize="12sp"
                    app:cornerRadius="18dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="0 / 15 sets completed"
                android:textColor="@color/kinetic_text_muted"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>