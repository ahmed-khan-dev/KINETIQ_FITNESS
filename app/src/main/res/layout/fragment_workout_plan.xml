<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kinetic_surface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/kinetic_primary"
            android:visibility="gone" />

        <!-- ============ EMPTY STATE ============ -->
        <LinearLayout
            android:id="@+id/emptyStateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/kinetic_card_surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kinetic_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏋️"
                        android:textSize="48sp" />

                    <TextView
                        android:id="@+id/tvEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Complete your profile to generate your personalized workout plan."
                        android:textColor="@color/kinetic_text_primary"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGeneratePlan"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/kinetic_primary"
                        android:letterSpacing="0.08"
                        android:text="Go to Profile"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        app:cornerRadius="18dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ============ MAIN PLAN CONTENT ============ -->
        <LinearLayout
            android:id="@+id/planContentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- PAGE HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMicrocycleTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:text="MICROCYCLE PROGRAM"
                        android:textColor="@color/kinetic_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWorkoutTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="-0.02"
                        android:text="Weekly Workout Plan"
                        android:textColor="@color/kinetic_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWorkoutSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.02"
                        android:text="4-Day Split Cycle"
                        android:textColor="@color/kinetic_text_muted"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- SPLIT BADGE -->
                <TextView
                    android:id="@+id/tvSplitBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stadium_pill"
                    android:backgroundTint="@color/kinetic_card_high"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="⚡ ACTIVE SPLIT"
                    android:textColor="@color/kinetic_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- WEEKLY RIBBON -->
            <HorizontalScrollView
                android:id="@+id/hsvWeeklyRibbon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llWeeklyRibbonDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- MON -->
                    <LinearLayout
                        android:id="@+id/btnDayMon"
                        android:layout_width="60dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDayMonLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="MON"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDayMonIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_card_highest"
                            android:gravity="center"
                            android:text="💪"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDayMonSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.1"
                            android:text="PLAN"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- TUE -->
                    <LinearLayout
                        android:id="@+id/btnDayTue"
                        android:layout_width="60dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDayTueLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="TUE"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDayTueIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_card_highest"
                            android:gravity="center"
                            android:text="🏋️"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDayTueSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.1"
                            android:text="PLAN"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- WED -->
                    <LinearLayout
                        android:id="@+id/btnDayWed"
                        android:layout_width="60dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDayWedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="WED"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDayWedIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_card_highest"
                            android:gravity="center"
                            android:text="🧘"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDayWedSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.1"
                            android:text="REST"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- THU -->
                    <LinearLayout
                        android:id="@+id/btnDayThu"
                        android:layout_width="60dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDayThuLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="THU"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDayThuIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_card_highest"
                            android:gravity="center"
                            android:text="🏃"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDayThuSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.1"
                            android:text="PLAN"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- FRI -->
                    <LinearLayout
                        android:id="@+id/btnDayFri"
                        android:layout_width="60dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDayFriLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="FRI"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDayFriIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_card_highest"
                            android:gravity="center"
                            android:text="⚡"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDayFriSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.1"
                            android:text="PLAN"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- SAT -->
                    <LinearLayout
                        android:id="@+id/btnDaySat"
                        android:layout_width="60dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDaySatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="SAT"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDaySatIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_card_highest"
                            android:gravity="center"
                            android:text="🛌"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDaySatSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.1"
                            android:text="REST"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- SUN -->
                    <LinearLayout
                        android:id="@+id/btnDaySun"
                        android:layout_width="60dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_day_tab_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDaySunLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="SUN"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDaySunIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stadium_pill"
                            android:backgroundTint="@color/kinetic_card_highest"
                            android:gravity="center"
                            android:text="🔄"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDaySunSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.1"
                            android:text="RELOAD"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- ============ SELECTED SESSION CARD ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/kinetic_card_surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/kinetic_card_high"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Tri-colour accent strip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/kinetic_primary" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/kinetic_secondary" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/kinetic_tertiary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Card header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_pulsing_dot" />

                            <TextView
                                android:id="@+id/tvSessionSectionBadge"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.15"
                                android:text="TODAY'S SCHEDULED SESSION"
                                android:textColor="@color/kinetic_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRpeBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_stadium_pill"
                                android:backgroundTint="@color/kinetic_card_high"
                                android:letterSpacing="0.06"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="RPE 8.0"
                                android:textColor="@color/kinetic_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTodayWorkoutTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:letterSpacing="-0.01"
                            android:text="Upper Body A — Hypertrophy"
                            android:textColor="@color/kinetic_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTodayWorkoutMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mon · 5 exercises · ~45 min"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="13sp" />

                        <!-- Telemetry chips -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvWorkoutMinutes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_stadium_pill"
                                android:backgroundTint="@color/kinetic_card_high"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="~45 min"
                                android:textColor="@color/kinetic_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvExerciseCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_stadium_pill"
                                android:backgroundTint="@color/kinetic_card_high"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="5 exercises"
                                android:textColor="@color/kinetic_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWorkoutFocus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_stadium_pill"
                                android:backgroundTint="@color/kinetic_card_high"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Chest, Back"
                                android:textColor="@color/kinetic_text_primary"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTodayWorkoutStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="0 / 12 sets completed"
                            android:textColor="@color/kinetic_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- DYNAMIC EXERCISE CARDS CONTAINER -->
                        <LinearLayout
                            android:id="@+id/llExerciseCardsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                        <!-- ADD CUSTOM EXERCISE -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddExerciseToSession"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:letterSpacing="0.06"
                            android:text="⊕  ADD CUSTOM EXERCISE"
                            android:textColor="@color/kinetic_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/kinetic_secondary" />

                        <!-- Fallback / Accessibility TextView with preserved ID -->
                        <TextView
                            android:id="@+id/tvTodayWorkoutExercises"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/kinetic_text_muted"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <!-- PRIMARY START WORKOUT -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartWorkout"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="@color/kinetic_primary"
                            android:letterSpacing="0.1"
                            android:text="▶  START WORKOUT"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp" />

                        <!-- START NEW WEEK -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartNewWeek"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="@color/kinetic_card_high"
                            android:letterSpacing="0.05"
                            android:text="⚡ START NEW WEEK / REPEAT PLAN"
                            android:textColor="@color/kinetic_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp" />

                        <!-- EXPORT PDF -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportPdf"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:letterSpacing="0.05"
                            android:text="📄 EXPORT WEEKLY PDF REPORT"
                            android:textColor="@color/kinetic_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:strokeColor="@color/kinetic_secondary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- HIDDEN PRESERVED CONTAINER FOR BACKWARD COMPATIBILITY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvScheduleCycleSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/llWeeklyScheduleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvWeeklyPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>